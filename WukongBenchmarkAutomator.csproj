<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WukongBenchmarkAutomator</RootNamespace>
    <AssemblyName>WukongBenchmarkAutomator</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Windows-only because the Benchmark Tool is Windows-only -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI for CPU / RAM / GPU enumeration -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Optional: real OCR later. Stub does not require it. -->
    <!-- <PackageReference Include="Tesseract" Version="5.2.0" /> -->
  </ItemGroup>

</Project>
